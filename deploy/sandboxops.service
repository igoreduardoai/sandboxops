[Unit]
Description=SandboxOps (Blast Radius Zero) web app
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=sandboxops
Group=docker
WorkingDirectory=/opt/sandboxops
EnvironmentFile=-/etc/sandboxops.env
Environment=PORT=80 SANDBOX=docker DOCKER_CONFIG=/tmp/.docker
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/python3 /opt/sandboxops/app.py
Restart=always
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
